# Password required to open the web page.
APP_PASSWORD=change-me

# Your RapidAPI key for bin-ip-checker.p.rapidapi.com. Stays on the server.
RAPIDAPI_KEY=your-rapidapi-key

# Port published on the Docker host.
HOST_PORT=8080

# Set to true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
